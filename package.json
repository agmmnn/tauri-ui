{
  "name": "tauri-ui",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "dev": "turbo run dev",
    "dev:ui": "bun run --cwd packages/create-tauri-ui ui:preview",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "check-types": "turbo run check-types",
    "release": "changeset publish",
    "test:create-tauri-ui": "node scripts/test-create-tauri-ui-simple.mjs",
    "test:create-tauri-ui:release": "node scripts/test-create-tauri-ui-release.mjs",
    "test:create-tauri-ui:workflow": "bun scripts/test-create-tauri-ui-workflow.ts",
    "test:create-tauri-ui:simple": "node scripts/test-create-tauri-ui-simple.mjs",
    "test:create-tauri-ui:full": "node scripts/test-create-tauri-ui-full.mjs",
    "taze": "taze minor -r -w -i false -I",
    "taze:major": "taze major -r -w -i false -I",
    "version-packages": "changeset version",
    "dev:docs": "bun run --cwd apps/docs dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "taze": "^19.16.0",
    "turbo": "^2.10.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14"
}
